# Copy to .env and fill in what you have. Flow Desk boots in DEMO mode with
# none of this set: no browser runs, no external API calls, deterministic
# decision provider, in-memory queue.

# --- Core (required outside demo mode) ---
DATABASE_URL="postgresql://flow_desk:flow_desk_dev@localhost:5433/flow_desk"
REDIS_URL="redis://localhost:6379"

# --- App mode ---
# demo | live
APP_MODE="demo"
# Session secret for the single-user dev auth cookie. Any random string in dev.
SESSION_SECRET="change-me-in-production"

# --- Decision provider ---
# Leave unset to use the deterministic demo provider.
JEV_API_KEY=
JEV_API_URL="https://api.jev.dev"

# --- Cover-letter generation provider ---
# Leave unset to use the template-only demo generator.
OPENAI_API_KEY=

# --- Optional discovery providers (not required for the local demo flow) ---
EXA_API_KEY=
TAVILY_API_KEY=
APIFY_TOKEN=
BROWSER_PROVIDER_API_KEY=

# --- Screenshot / artifact storage ---
# local | s3
SCREENSHOT_STORAGE_DRIVER="local"
SCREENSHOT_STORAGE_DIR="./.data/screenshots"
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL="info"

# --- Browser worker limits ---
BROWSER_CONCURRENCY="3"
BROWSER_PER_DOMAIN_CONCURRENCY="2"
BROWSER_MAX_PAGES_PER_FLOW="3"
BROWSER_MAX_STEPS_PER_FLOW="20"
BROWSER_MAX_DURATION_SECONDS="120"
